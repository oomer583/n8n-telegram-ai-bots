# Copy this file to .env and fill in real values. Never commit .env.

# Long random string. n8n encrypts every saved credential with it.
# If you change it later, no saved credential can be decrypted again.
N8N_ENCRYPTION_KEY=change_me_to_a_long_random_string

# Public HTTPS URL that Telegram can reach, e.g. https://bots.example.com/
WEBHOOK_URL=https://change-me.example.com/

# Postgres
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_me
POSTGRES_DB=n8n_bots
